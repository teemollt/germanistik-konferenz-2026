---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === base || currentPath === `${base}/` || currentPath.endsWith("index.html");

const getLink = (id: string) => {
    return isHomePage ? `#${id}` : `${base}#${id}`;
}
---
<header class="bg-[#192A4D]/70 backdrop-blur-lg sticky top-0 z-50">
    <div class="container mx-auto px-4 py-3 flex justify-between items-center">
        <div class="flex items-center gap-3 md:gap-4">
            <!-- 인천대 로고 그룹 -->
            <div class="flex items-end gap-2">
                <a href="https://www.inu.ac.kr/" target="_blank" rel="noopener noreferrer" title="Incheon National University Homepage">
                    <img src="/photos/inulogo.svg" alt="Incheon National University Logo" class="h-8 w-auto">
                </a>
            </div>
        </div>
        
        <!-- Desktop Navigation (이하 동일) -->
        <nav class="hidden md:flex space-x-6 text-slate-300 font-medium items-center">
            <a href=`${base}about` class="nav-link" data-lang-key="navAbout">Über AGT</a>
            <a href=`${base}president-message` class="nav-link" data-lang-key="navPresidentMessage">Grußwort</a>
            <a href={getLink('theme')} class="nav-link" data-lang-key="navTheme">Themenbeschreibung</a>
            <a href={getLink('informationen')} class="nav-link" data-lang-key="navInfo">Informationen</a>
            <a href={getLink('contact')} class="nav-link" data-lang-key="navContact">Kontakt</a>
            <div class="lang-switcher text-sm font-medium ml-6">
                <button id="lang-de-desktop" class="p-1">Deutsch</button>
                <span class="text-slate-500">|</span>
                <button id="lang-en-desktop" class="p-1">Englisch</button>
            </div>
        </nav>

        <!-- Mobile Menu Button (이하 동일) -->
        <div class="md:hidden">
            <button id="mobile-menu-button" class="text-white p-2 focus:outline-none">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
            </button>
        </div>
    </div>
    <div id="mobile-menu" class="hidden md:hidden bg-[#14223f]">
        <nav class="px-4 pt-2 pb-4 space-y-2">
            <a href=`${base}about` class="nav-link block py-2" data-lang-key="navAbout">Über AGT</a>
            <a href=`${base}president-message` class="nav-link block py-2" data-lang-key="navPresidentMessage">Grußwort</a>
            <a href={getLink('theme')} class="nav-link block py-2" data-lang-key="navTheme">Themenbeschreibung</a>
            <a href={getLink('informationen')} class="nav-link block py-2" data-lang-key="navInfo">Informationen</a>
            <a href={getLink('contact')} class="nav-link block py-2" data-lang-key="navContact">Kontakt</a>
        </nav>
        <div class="lang-switcher text-center border-t border-slate-700 py-4">
            <button id="lang-de-mobile" class="p-1">Deutsch</button>
            <span class="text-slate-500">|</span>
            <button id="lang-en-mobile" class="p-1">Englisch</button>
        </div>
    </div>
</header>