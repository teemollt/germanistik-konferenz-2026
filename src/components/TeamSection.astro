---
import { content } from '../i18n/content';
---

<section id="contact" class="py-20 md:py-24 bg-[#14223f]">
    <div class="container mx-auto px-6" data-aos="fade-up">
        <div class="text-center mb-16 border-b border-slate-700 pb-8">
            <h2 class="section-title" data-lang-key="contactTitle">Kontakt</h2>
            <p class="text-white text-xl font-bold" data-lang-key="contactEmail">agt2027.incheon@gmail.com</p>
            <p class="text-slate-400 mt-2 text-md" data-lang-key="contactAssistant">Gwon Minseo (Korea University)</p>
        </div>
        <p class="font-bold text-white text-center text-xl mb-6" data-lang-key="teamTitle">AGT-Organisationsteam</p>
        <div id="team-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 text-center" data-lang-team-list>
            {content.de.teamMembers.map(member => (
                <div>
                    <p class="font-bold text-white">{member.name}</p>
                    <p class="text-sm text-slate-400">{member.role}<br />{member.institution}</p>
                </div>
            ))}
        </div>
    </div>
</section>
