---
interface Props {
  title: string;
  href: string;
  backgroundImage: string;
  langKey: string;
}

const { title, href, backgroundImage, langKey } = Astro.props;
---

<a href={href} class="group relative block rounded-md overflow-hidden shadow-[0_16px_40px_rgba(0,0,0,0.22)] h-64 ring-1 ring-white/10">
  <div
  class="absolute inset-0 bg-cover bg-center filter blur-md transition-transform duration-500 ease-out group-hover:scale-105"
  style={`background-image: url('${backgroundImage}')`}
  ></div>

  <div
  class="absolute inset-0 bg-contain bg-no-repeat bg-center transition-transform duration-500 ease-out group-hover:scale-105"
  style={`background-image: url('${backgroundImage}')`}
  ></div>

  <div class="absolute inset-0 
              bg-gradient-to-t 
              from-[#06101f]/45 via-[#06101f]/15 to-transparent">
  </div>
  <div class="absolute inset-0 bg-black/5"></div>
  <div class="relative h-full flex items-center justify-center">
    <h3 class="text-2xl font-bold text-white text-center px-4" data-lang-key={langKey}>{title}</h3>
  </div>
</a>
