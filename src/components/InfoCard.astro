---
interface Props {
  title: string;
  href: string;
  backgroundImage: string;
  langKey: string;
}

const { title, href, backgroundImage, langKey } = Astro.props;
---

<a href={href} class="group relative block rounded-lg overflow-hidden shadow-lg h-64">
  <div
    class="absolute inset-0 bg-cover bg-center transition-transform duration-300 ease-in-out group-hover:scale-110"
    style={`background-image: url('${backgroundImage}')`}
  ></div>
  <div class="absolute inset-0 bg-black/10"></div>
  <div class="relative h-full flex items-center justify-center">
    <h3 class="text-2xl font-bold text-white text-center px-4" data-lang-key={langKey}>{title}</h3>
  </div>
</a>