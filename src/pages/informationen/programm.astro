---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { content } from '../../i18n/content';
---

<Layout title="Programm und Sektionen - AGT 2026 Incheon">
    <Header />
    <main class="relative z-30 py-20 md:py-24">
        <div class="container mx-auto px-6">
            <h2 class="text-4xl md:text-5xl font-extrabold text-center mb-12 md:mb-16" data-lang-key="venueProgramTitle">Programm und Sektionen</h2>
            <div class="max-w-4xl mx-auto text-slate-300 text-lg leading-relaxed space-y-6">
                <p data-lang-key="venueProgramDesc">Das detaillierte Programm wird nach Abschluss der Sektions- und Vortragsanmeldungen bekannt gegeben. Erwarten Sie spannende Keynotes, vielfältige Sektionen und interaktive Workshops.</p>
                <!-- More content can be added here -->
            </div>
        </div>
    </main>
    <Footer />
</Layout>