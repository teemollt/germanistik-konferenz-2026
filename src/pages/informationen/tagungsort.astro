---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { content } from '../../i18n/content';

const t = (key: string) => (content.de as unknown as Record<string, string>)[key] ?? key;

// 버스 정보 데이터
const busesViaINUStation = [
  {
    number: "8, 8A",
    type: "trunk",
    finalStopKey: "venueBus8Final",
    intermediateKey: "venueBus8Intermediate"
  },
  {
    number: "58",
    type: "trunk", 
    finalStopKey: "venueBus58Final",
    intermediateKey: "venueBus58Intermediate"
  },
  {
    number: "41",
    type: "circular",
    finalStopKey: "venueBus41Final",
    intermediateKey: "venueBus41Intermediate"
  },
  {
    number: "46", 
    type: "circular",
    finalStopKey: "venueBus46Final",
    intermediateKey: "venueBus46Intermediate"
  },
  {
    number: "3002",
    type: "express",
    finalStopKey: "venueBus3002Final",
    intermediateKey: "venueBus3002Intermediate"
  }
];

const busesViaCampus = [
  {
    number: "6, 6-1",
    type: "trunk",
    finalStopKey: "venueBus6Final",
    intermediateKey: "venueBus6Intermediate"
  },
  {
    number: "43",
    type: "circular", 
    finalStopKey: "venueBus43Final",
    intermediateKey: "venueBus43Intermediate"
  },
  {
    number: "1301",
    type: "metro-express",
    finalStopKey: "venueBus1301Final",
    intermediateKey: "venueBus1301Intermediate"
  },
  {
    number: "M6405",
    type: "metro-rapid",
    finalStopKey: "venueBusM6405Final",
    intermediateKey: "venueBusM6405Intermediate"
  }
];

const outsideRoutes = [
  {
    titleKey: "venueFromIncheonAirport",
    routeKey: "venueRouteIncheonAirport"
  },
  {
    titleKey: "venueFromGimpoAirport", 
    routeKey: "venueRouteGimpoAirport"
  },
  {
    titleKey: "venueFromSeoulStation",
    routeKey: "venueRouteSeoulStation"
  },
  {
    titleKey: "venueFromYongsanStation",
    routeKey: "venueRouteYongsanStation"
  },
  {
    titleKey: "venueFromGwangmyeongStation", 
    routeKey: "venueRouteGwangmyeongStation"
  },
  {
    titleKey: "venueFromIncheonBusTerminal",
    routeKey: "venueRouteIncheonBusTerminal"
  }
];

// 버스 타입별 색상 반환 함수
function getBusColor(type) {
  const colors = {
    'trunk': 'trunk',
    'circular': 'circular', 
    'express': 'express',
    'metro-express': 'metro-express',
    'metro-rapid': 'metro-rapid'
  };
  return colors[type] || 'trunk';
}
---

<Layout title={`${t('directionsTitle')} - AGT 2027 Incheon`}>
    <Header />
    <main class="relative z-30 py-20 md:py-24">
        <!-- 상단 소개 섹션 -->
        <section id="venue-intro" class="container mx-auto px-6 mb-16">
            <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
                <div data-aos="fade-right">
                    <h1 class="text-4xl md:text-5xl font-extrabold mb-8" data-lang-key="directionsTitle">{t('directionsTitle')}</h1>
                    <div class="space-y-6 text-lg">
                        <div>
                            <h2 class="font-bold text-white text-2xl mb-4" data-lang-key="venueUniTitle">{t('venueUniTitle')}</h2>
                            <p class="text-slate-300 mb-4" data-lang-key="venueUniDesc">{t('venueUniDesc')}</p>
                            <div class="bg-slate-800/50 rounded-lg p-4 border border-slate-700">
                                <h3 class="font-semibold text-[#d2b06a] mb-2" data-lang-key="venueCampusAddressTitle">{t('venueCampusAddressTitle')}</h3>
                                <p class="text-slate-300" data-lang-key="venueCampusAddress">{t('venueCampusAddress')}</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div data-aos="fade-left">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6340.912738065522!2d126.63315005991981!3d37.37903827139401!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x357b7647b970dccb%3A0x725b8c47c9639a11!2sIncheon%20National%20University%20(INU)%2C%20Songdo%20Campus!5e0!3m2!1sen!2skr!4v1758703744727!5m2!1sen!2skr" class="rounded-lg shadow-2xl w-full h-96" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </section>

        <!-- 메인 길안내 섹션 -->
        <section id="directions-content" class="container mx-auto px-6">
            <div class="text-center mb-12 md:mb-16" data-aos="fade-up">
                <h2 class="text-3xl md:text-4xl font-bold mb-4" data-lang-key="directionsSubtitle">{t('directionsSubtitle')}</h2>
                <p class="text-lg text-slate-300" data-lang-key="directionsIntro">{t('directionsIntro')}</p>
            </div>

            <!-- 탭 네비게이션 -->
            <div class="flex justify-center border-b border-slate-700 mb-12" data-aos="fade-up" role="tablist" aria-label={t('venueDirectionsOptions')}>
                <button type="button" role="tab" aria-selected="true" aria-controls="from-outside" data-tab="from-outside" class="tab-btn active px-6 py-3 text-lg font-semibold border-b-2" data-lang-key="venueTab1">{t('venueTab1')}</button>
                <button type="button" role="tab" aria-selected="false" aria-controls="from-downtown" data-tab="from-downtown" class="tab-btn px-6 py-3 text-lg font-semibold border-b-2" data-lang-key="venueTab2">{t('venueTab2')}</button>
            </div>

            <!-- 시외 교통편 탭 -->
            <div id="from-outside" class="tab-content" role="tabpanel">
                <div class="grid gap-6 mb-12" data-aos="fade-up">
                    {outsideRoutes.map((route) => (
                        <div class="route-card bg-slate-800/50 rounded-lg p-6 border border-slate-700">
                            <h3 class="text-xl font-bold text-[#d2b06a] mb-3" data-lang-key={route.titleKey}>{t(route.titleKey)}</h3>
                            <div class="flex items-center gap-4 text-slate-300">
                                <span class="text-2xl">🚌</span>
                                <p data-lang-key={route.routeKey}>{t(route.routeKey)}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <!-- 시내 교통편 탭 -->
            <div id="from-downtown" class="tab-content hidden" role="tabpanel">
                <div class="info-box bg-slate-800/30 rounded-lg p-6 border border-slate-700" data-aos="fade-up">
                    <h3 class="text-2xl font-bold text-white mb-6 border-b border-slate-600 pb-4">
                        <span class="text-[#d2b06a]">📍</span> <span data-lang-key="venueStationGuide">{t('venueStationGuide')}</span>
                    </h3>
                    <div class="grid md:grid-cols-3 gap-8 items-stretch">
                        <div class="md:col-span-2 flex flex-col gap-6">
                            <div class="bg-slate-700/50 rounded-lg p-6 flex-grow">
                                <h4 class="font-bold text-[#d2b06a] mb-4 flex items-center gap-2 text-xl">
                                    <span>🚇</span> <span data-lang-key="venueSubwayExitGuide">{t('venueSubwayExitGuide')}</span>
                                </h4>
                                <div>
                                    <p class="text-slate-300 mb-4" data-lang-key="venueSubwayStation">{t('venueSubwayStation')}</p>
                                    <div class="flex gap-2">
                                        <span class="bg-[#4f73a8] text-white px-3 py-1 rounded-full text-sm font-bold" data-lang-key="venueExit1">{t('venueExit1')}</span>
                                        <span class="bg-[#4f73a8] text-white px-3 py-1 rounded-full text-sm font-bold" data-lang-key="venueExit2">{t('venueExit2')}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="bg-slate-700/50 rounded-lg p-6 flex-grow">
                                <h4 class="font-bold text-[#d2b06a] mb-3 flex items-center gap-2">
                                    <span>🚌</span> <span data-lang-key="venueBusInformation">{t('venueBusInformation')}</span>
                                </h4>
                                <div class="space-y-2 text-sm">
                                    <p><span class="text-blue-400 font-semibold" data-lang-key="venueSchoolShuttleLabel">{t('venueSchoolShuttleLabel')}</span> <span data-lang-key="venueSchoolShuttleValue">{t('venueSchoolShuttleValue')}</span></p>
                                    <p><span class="text-green-400 font-semibold" data-lang-key="venueTrunkBuses">{t('venueTrunkBuses')}</span> 8, 8A, 16, 58</p>
                                    <p><span class="text-purple-400 font-semibold" data-lang-key="venueCircularBuses">{t('venueCircularBuses')}</span> 41, 46</p>
                                    <p><span class="text-red-400 font-semibold" data-lang-key="venueDirectBus">{t('venueDirectBus')}</span> 3002</p>
                                </div>
                            </div>
                        </div>
                        <div class="hidden md:block md:col-span-1">
                            <img src="/icons/subwayexit.svg" alt="Subway Exit Guide" loading="lazy" decoding="async" class="rounded-lg w-full h-full object-cover opacity-70" />
                        </div>
                    </div>
                </div>
            </div>

                <!-- 버스 경로 테이블들 -->
                <div class="space-y-12" data-aos="fade-up">
                    <!-- 인천대입구역 경유 버스 -->
                    <div>
                        <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
                            <span class="text-blue-400">🚌</span>
                            <span data-lang-key="venueBusesViaStation">{t('venueBusesViaStation')}</span>
                        </h3>
                        <div class="overflow-x-auto rounded-lg border border-slate-700">
                            <table class="w-full bg-slate-800">
                                <thead class="bg-slate-700">
                                    <tr>
                                        <th class="p-4 text-left font-semibold text-slate-200" data-lang-key="venueBusNumber">{t('venueBusNumber')}</th>
                                        <th class="p-4 text-left font-semibold text-slate-200" data-lang-key="venueFinalStop">{t('venueFinalStop')}</th>
                                        <th class="p-4 text-left font-semibold text-slate-200" data-lang-key="venueIntermediateStop">{t('venueIntermediateStop')}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {busesViaINUStation.map((bus, index) => (
                                        <tr class={`border-b border-slate-700 ${index % 2 === 0 ? 'bg-slate-800' : 'bg-slate-750'}`}>
                                            <td class="p-4">
                                                <div class="flex items-center gap-2">
                                                    <span class={`bus-badge ${getBusColor(bus.type)}`}>{bus.number}</span>
                                                </div>
                                            </td>
                                            <td class="p-4 text-slate-300 text-sm" data-lang-key={bus.finalStopKey}>{t(bus.finalStopKey)}</td>
                                            <td class="p-4 text-slate-300 text-sm" data-lang-key={bus.intermediateKey}>{t(bus.intermediateKey)}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- 송도캠퍼스 경유 버스 -->
                    <div>
                        <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
                            <span class="text-green-400">🚌</span>
                            <span data-lang-key="venueBusesViaCampus">{t('venueBusesViaCampus')}</span>
                        </h3>
                        <div class="overflow-x-auto rounded-lg border border-slate-700">
                            <table class="w-full bg-slate-800">
                                <thead class="bg-slate-700">
                                    <tr>
                                        <th class="p-4 text-left font-semibold text-slate-200" data-lang-key="venueBusNumber">{t('venueBusNumber')}</th>
                                        <th class="p-4 text-left font-semibold text-slate-200" data-lang-key="venueFinalStop">{t('venueFinalStop')}</th>
                                        <th class="p-4 text-left font-semibold text-slate-200" data-lang-key="venueIntermediateStop">{t('venueIntermediateStop')}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {busesViaCampus.map((bus, index) => (
                                        <tr class={`border-b border-slate-700 ${index % 2 === 0 ? 'bg-slate-800' : 'bg-slate-750'}`}>
                                            <td class="p-4">
                                                <div class="flex items-center gap-2">
                                                    <span class={`bus-badge ${getBusColor(bus.type)}`}>{bus.number}</span>
                                                </div>
                                            </td>
                                            <td class="p-4 text-slate-300 text-sm" data-lang-key={bus.finalStopKey}>{t(bus.finalStopKey)}</td>
                                            <td class="p-4 text-slate-300 text-sm" data-lang-key={bus.intermediateKey}>{t(bus.intermediateKey)}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 추가 정보 -->
                <div class="mt-12 grid md:grid-cols-2 gap-8" data-aos="fade-up">
                    <div class="bg-blue-900/20 rounded-lg p-6 border border-blue-700/50">
                        <h4 class="font-bold text-blue-400 mb-3 flex items-center gap-2">
                            <span>💡</span> <span data-lang-key="venueProTipsTitle">{t('venueProTipsTitle')}</span>
                        </h4>
                        <ul class="text-slate-300 space-y-2 text-sm">
                            <li data-lang-key="venueTipPayment">{t('venueTipPayment')}</li>
                            <li data-lang-key="venueTipRealtime">{t('venueTipRealtime')}</li>
                            <li data-lang-key="venueTipShuttle">{t('venueTipShuttle')}</li>
                            <li data-lang-key="venueTipRushHours">{t('venueTipRushHours')}</li>
                        </ul>
                    </div>
                    <div class="bg-green-900/20 rounded-lg p-6 border border-green-700/50">
                        <h4 class="font-bold text-green-400 mb-3 flex items-center gap-2">
                            <span>🕐</span> <span data-lang-key="venueScheduleNotesTitle">{t('venueScheduleNotesTitle')}</span>
                        </h4>
                        <ul class="text-slate-300 space-y-2 text-sm">
                            <li>• <strong data-lang-key="venuePublicTransitLabel">{t('venuePublicTransitLabel')}</strong> <span data-lang-key="venuePublicTransitDesc">{t('venuePublicTransitDesc')}</span></li>
                            <li>• <strong data-lang-key="venueSchoolShuttleScheduleLabel">{t('venueSchoolShuttleScheduleLabel')}</strong> <span data-lang-key="venueSchoolShuttleScheduleDesc">{t('venueSchoolShuttleScheduleDesc')}</span></li>
                            <li>• <strong data-lang-key="venueConferencePeriodLabel">{t('venueConferencePeriodLabel')}</strong> <span data-lang-key="venueConferencePeriodDesc">{t('venueConferencePeriodDesc')}</span></li>
                            <li>• <strong data-lang-key="venueRealtimeAppsLabel">{t('venueRealtimeAppsLabel')}</strong> <span data-lang-key="venueRealtimeAppsDesc">{t('venueRealtimeAppsDesc')}</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tabButtons = document.querySelectorAll('[data-tab]');
        const tabPanels = document.querySelectorAll('.tab-content');

        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                const targetId = button.getAttribute('data-tab');

                tabButtons.forEach(tab => {
                    const isActive = tab === button;
                    tab.classList.toggle('active', isActive);
                    tab.setAttribute('aria-selected', String(isActive));
                });

                tabPanels.forEach(panel => {
                    panel.classList.toggle('hidden', panel.id !== targetId);
                });
            });
        });
    });
</script>

<style>
    .tab-btn {
        transition: all 0.3s ease;
        color: #94A3B8;
        border-bottom-color: transparent;
    }
    
    .tab-btn:hover {
        color: #E2E8F0;
    }
    
    .tab-btn.active {
        color: #D2B06A;
        border-bottom-color: #D2B06A;
    }
    
    .route-card {
        transition: all 0.3s ease;
    }
    
    .route-card:hover {
        background-color: rgba(30, 41, 59, 0.7);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
    }
    
    .bus-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-weight: 700;
        font-size: 0.875rem;
        font-family: monospace;
    }
    
    .trunk { background-color: #4F73A8; color: white; }
    .circular { background-color: #4F8B73; color: white; }
    .express { background-color: #A75C54; color: white; }
    .metro-express { background-color: #75649E; color: white; }
    .metro-rapid { background-color: #D2B06A; color: #111827; }
    
    .subway-map {
        min-height: 200px;
    }
    
    .info-box {
        backdrop-filter: blur(10px);
    }
    
    tbody tr:hover {
        background-color: rgba(51, 65, 85, 0.8);
    }
    
    .subway-exit-svg {
        opacity: 0.7;
        filter: brightness(0.8);
    }

    @media (max-width: 768px) {
        .tab-btn {
            padding: 0.75rem 1rem;
            font-size: 1rem;
        }
        
        table {
            font-size: 0.875rem;
        }
        
        .bus-badge {
            font-size: 0.75rem;
            padding: 0.2rem 0.5rem;
        }
    }
</style>
