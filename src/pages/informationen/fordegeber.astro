---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Fördergeber - AGT 2027 Incheon">
    <Header />
    <main class="relative z-30 py-20 md:py-24 bg-[#14223f]">
        <div class="container mx-auto px-6">
            <h2 class="text-4xl md:text-5xl font-extrabold text-center mb-12 md:mb-16" data-lang-key="subInfoFoerdergeber">Fördergeber</h2>
            <div class="max-w-4xl mx-auto text-slate-300">
                <p class="mb-4" data-lang-key="sponsorsDesc1">
                    Wir danken unseren Fördergebern und Sponsoren für ihre großzügige Unterstützung.
                </p>
                <p data-lang-key="sponsorsDesc2">
                    Eine Liste unserer Partner wird hier in Kürze veröffentlicht.
                </p>
            </div>
        </div>
    </main>
    <Footer />
</Layout>
