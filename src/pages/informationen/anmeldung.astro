---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Anmeldung - AGT 2027 Incheon">
    <Header />
    <main class="relative z-30 py-20 md:py-24 bg-[#14223f] text-slate-300">
        <div class="container mx-auto px-6">
            <h2 class="text-4xl md:text-5xl font-extrabold text-center mb-12 md:mb-16 text-white" data-lang-key="registerTitle">Anmeldung</h2>

            <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                
                <!-- Card 1: Sektionsleitung -->
                <div class="bg-slate-800/70 p-8 rounded-md text-center flex flex-col border border-slate-600/50 shadow-[0_10px_24px_rgba(0,0,0,0.12)] opacity-90">
                    <div class="flex-grow">
                        <h3 class="text-2xl font-bold text-slate-300" data-lang-key="registerType1Title">1. Sektionsleitung</h3>
                        <p class="mt-4 font-semibold text-[#d2b06a]/75" data-lang-key="sectionLeaderClosedNotice">
                            Die Bewerbungsphase für die Sektionsleitung ist abgeschlossen.
                        </p>
                        <p class="mt-3 text-sm leading-relaxed text-slate-400" data-lang-key="sectionLeaderProgramNotice">
                            Informationen zu den angenommenen Sektionen finden Sie unter Informationen - Programm und Sektionen.
                        </p>
                    </div>
                    <a href={`${base}informationen/programm/`} class="mt-6 inline-flex items-center justify-center rounded-md border border-slate-500/60 bg-slate-800/60 px-6 py-2 font-semibold text-slate-300 transition hover:border-slate-400/70 hover:bg-slate-700/50 hover:text-white" data-lang-key="registerType1Btn">Programm und Sektionen</a>
                </div>

                <!-- Card 2: Vortragende -->
                <div class="bg-slate-800 p-8 rounded-md text-center flex flex-col border border-[#d2b06a]/50 shadow-[0_12px_30px_rgba(0,0,0,0.18)] transition hover:border-[#d2b06a]/65">
                    <div class="flex-grow">
                        <h3 class="text-2xl font-bold text-white" data-lang-key="registerType2Title">2. Vortragende</h3>
                        <p class="text-slate-400 mt-2" data-lang-key="registerType2Deadline">Bewerbungsfrist: Mai - Dez. 2026</p>
                        <p class="mt-4" data-lang-key="registerType2Desc">Präsentieren Sie Ihre Forschungsergebnisse einem internationalen Publikum.</p>
                        <div class="mt-5 rounded-sm border border-[#d2b06a]/25 bg-black/25 p-3 text-left text-xs text-slate-300">
                            <p class="font-semibold text-[#ead59a]" data-lang-key="presentationNoticeTitle">Hinweis zur Vortragseinreichung</p>
                            <p class="mt-2" data-lang-key="presentationSectionLeaderContactNotice">Bei Fragen wenden Sie sich bitte direkt per E-Mail an die jeweilige Sektionsleitung.</p>
                            <p class="mt-2" data-lang-key="presentationSectionRequirement">Bitte geben Sie im Formular unbedingt an, in welcher Sektion Sie vortragen möchten.</p>
                            <p class="mt-2" data-lang-key="presentationSameAsSectionNotice">Die weiteren Angaben orientieren sich am Formular für die Sektionsleitung.</p>
                        </div>
                    </div>
                    <a href="https://forms.gle/sYJfXE1iv74ZLpfb6" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block btn-gold font-semibold px-6 py-2 rounded-md transition" data-lang-key="registerType2Btn">Formular (Vortrag)</a>
                </div>

                <!-- Card 3: Teilnehmende -->
                <div class="bg-slate-800 p-8 rounded-md text-center flex flex-col border border-[#d2b06a]/50 shadow-[0_12px_30px_rgba(0,0,0,0.18)] transition hover:border-[#d2b06a]/65">
                    <div class="flex-grow">
                        <h3 class="text-2xl font-bold text-white" data-lang-key="registerType3Title">3. Teilnehmende</h3>
                        <p class="text-slate-400 mt-2" data-lang-key="registerType3Deadline">Anmeldung: ab Mai 2026</p>
                        <p class="mt-4" data-lang-key="registerType3Desc">Nehmen Sie an den Diskussionen teil und vernetzen Sie sich mit Kollegen.</p>
                    </div>
                    <a href="https://docs.google.com/forms/d/e/1FAIpQLSdOTPxDxUKAlXO0-ICfc8ZAjDwqm4BFZRAjpd-9YIHa02Ikcg/viewform" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block btn-gold font-semibold px-6 py-2 rounded-md transition" data-lang-key="registerType3Btn">Formular (Teilnahme)</a>
                </div>
            </div>

            <!-- Common Notices & Fee Info Section -->
            <div class="max-w-6xl mx-auto mt-12 p-8 bg-slate-900 rounded-md border border-[#d2b06a]/20">
                <!-- 구글 접속 불가 인원에 대한 안내 -->
                <div class="text-center p-4 mb-8 bg-[#d2b06a]/10 border-l-4 border-[#d2b06a] rounded-sm">
                    <p class="font-semibold text-white" data-lang-key="googleFormNoticeTitle">
                        Wichtiger Hinweis: Online-Anmeldeformulare (Google Forms)
                    </p>
                    <p class="text-sm text-slate-300 mt-2" data-lang-key="googleFormNoticeBody">
                        Alle oben genannten "Formular"-Buttons leiten zu Google Forms weiter. Der Zugriff kann in Regionen, in denen Google-Dienste blockiert sind (z. B. China), eingeschränkt sein.
                    </p>
                    <p class="text-sm font-bold text-[#ead59a] mt-2" data-lang-key="googleFormAlternative">
                        Bei Problemen mit dem Zugriff bitten wir Sie um eine separate Anmeldung per E-Mail an:
                    </p>
                    <a href="mailto:agt2027.incheon@gmail.com" class="underline text-[#ead59a] hover:text-white">agt2027.incheon@gmail.com</a>
                </div>
                <!-- 공통 안내 -->
                <!-- <div class="text-center">
                    <p class="text-slate-200" data-lang-key="registrationCommonNotice">
                        Alle Anmeldeformulare (Sektion, Vortrag, Teilnahme) enthalten auch die Anmeldung für das Rahmenprogramm.
                    </p>
                    <p class="text-[#ead59a] mt-2" data-lang-key="registerNote">
                        * Sektionsleiter und Vortragende müssen sich ebenfalls als Teilnehmende registrieren.
                    </p>
                </div> -->

                <div class="border-t border-slate-700 pt-6 mt-6">
                    <h3 class="text-2xl font-bold text-white text-center mb-4" data-lang-key="feeDetailsTitle">Teilnahmegebühren</h3>
                    <ul class="flex flex-col md:flex-row justify-center items-center gap-4 md:gap-8 text-lg text-center mb-6">
                        <li class="flex items-center gap-2" data-lang-key="feeFullTime"><span class="w-2.5 h-2.5 inline-block bg-[#d2b06a] rounded-full"></span>Vollzeit/Teilzeit: 150.000 KRW</li>
                        <li class="flex items-center gap-2" data-lang-key="feeStudent"><span class="w-2.5 h-2.5 inline-block bg-[#d2b06a] rounded-full"></span>Studierende: 50.000 KRW</li>
                    </ul>
                    <div class="text-center p-4 bg-slate-800 rounded-md mb-4">
                        <h4 class="text-xl font-bold text-[#d2b06a] mb-2" data-lang-key="bankTransferTitle">Überweisung / Bank Transfer</h4>
                        <p class="text-base text-white font-mono" data-lang-key="bankDetails">
                            Kookmin Bank (KB): 098001-00-005911
                        </p>
                        <p class="text-sm text-slate-400" data-lang-key="bankAccountHolder">
                            (name: KGG)
                        </p>
                        <ul class="text-sm text-slate-400 mt-4" data-lang-key-list="internationalBankInfo">
                        </ul>
                   </div>
                    <div class="text-center border-t border-slate-800 pt-4 mt-4">
                         <p class="font-semibold text-[#ead59a]" data-lang-key="paymentCompletionNotice">
                            Die Anmeldung ist erst nach Eingang der Teilnahmegebühr (ggf. inkl. der Gebühr für das Rahmenprogramm) abgeschlossen.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </main>
    <Footer />
</Layout>
