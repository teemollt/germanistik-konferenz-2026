---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { content } from '../../i18n/content';
---

<Layout title="Anmeldung - AGT 2027 Incheon">
    <Header />
    <main class="relative z-30 py-20 md:py-24 bg-[#14223f] text-slate-300">
        <div class="container mx-auto px-6">
            <h2 class="text-4xl md:text-5xl font-extrabold text-center mb-12 md:mb-16 text-white" data-lang-key="registerTitle">Anmeldung</h2>

            <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                
                <!-- Card 1: Sektionsleitung -->
                <div class="bg-slate-800 p-8 rounded-lg text-center flex flex-col border-2 border-amber-400/50">
                    <div class="flex-grow">
                        <h3 class="text-2xl font-bold text-white" data-lang-key="registerType1Title">1. Sektionsleitung</h3>
                        <p class="text-slate-400 mt-2" data-lang-key="registerType1Deadline">Bewerbungsfrist: Ende März 2026</p>
                        <p class="mt-4" data-lang-key="registerType1Desc">Leiten Sie eine Sektion und gestalten Sie das wissenschaftliche Programm aktiv mit.</p>
                        <p class="text-xs text-amber-300 mt-4 p-2 bg-black/40 rounded" data-lang-key="sectionRequirements">
                            Für die Bewerbung als Sektionsleitung ist eine Beschreibung des Sektionsthemas im Umfang von einer A4-Seite (inkl. Bibliographie) zwingend erforderlich.
                        </p>
                    </div>
                    <a href="https://forms.gle/ymUHq9ZPD3z3a7jJ7" target="_blank" class="mt-6 inline-block btn-gold font-semibold px-6 py-2 rounded-md transition" data-lang-key="registerType1Btn">Formular (Sektion)</a>
                </div>

                <!-- Card 2: Vortragende -->
                <div class="bg-slate-800 p-8 rounded-lg text-center flex flex-col">
                    <div class="flex-grow">
                        <h3 class="text-2xl font-bold text-white" data-lang-key="registerType2Title">2. Vortragende</h3>
                        <p class="text-slate-400 mt-2" data-lang-key="registerType2Deadline">Bewerbungsfrist: Mai - Dez. 2026</p>
                        <p class="mt-4" data-lang-key="registerType2Desc">Präsentieren Sie Ihre Forschungsergebnisse einem internationalen Publikum.</p>
                    </div>
                    <a href="https://forms.gle/ymUHq9ZPD3z3a7jJ7" target="_blank" class="mt-6 inline-block btn-gold font-semibold px-6 py-2 rounded-md transition" data-lang-key="registerType2Btn">Formular (Vortrag)</a>
                </div>

                <!-- Card 3: Teilnehmende -->
                <div class="bg-slate-800 p-8 rounded-lg text-center flex flex-col">
                    <div class="flex-grow">
                        <h3 class="text-2xl font-bold text-white" data-lang-key="registerType3Title">3. Teilnehmende</h3>
                        <p class="text-slate-400 mt-2" data-lang-key="registerType3Deadline">Anmeldung: ab Mai 2026</p>
                        <p class="mt-4" data-lang-key="registerType3Desc">Nehmen Sie an den Diskussionen teil und vernetzen Sie sich mit Kollegen.</p>
                    </div>
                    <a href="https://forms.gle/ymUHq9ZPD3z3a7jJ7" target="_blank" class="mt-6 inline-block btn-gold font-semibold px-6 py-2 rounded-md transition" data-lang-key="registerType3Btn">Formular (Teilnahme)</a>
                </div>
            </div>

            <!-- Common Notices & Fee Info Section -->
            <div class="max-w-6xl mx-auto mt-12 p-8 bg-slate-900 rounded-lg border border-amber-400/20">
                <!-- 구글 접속 불가 인원에 대한 안내 -->
                <div class="text-center p-4 mb-8 bg-amber-400/10 border-l-4 border-amber-400 rounded-lg">
                    <p class="font-semibold text-white" data-lang-key="googleFormNoticeTitle">
                        <i class="fas fa-exclamation-triangle mr-2"></i> 중요 안내: 온라인 신청서 (Google Forms)
                    </p>
                    <p class="text-sm text-slate-300 mt-2" data-lang-key="googleFormNoticeBody">
                        위에 안내된 모든 **'Formular' 버튼**은 **Google Forms**로 연결됩니다. 중국 등 Google 서비스 접속이 어려운 지역에서는 접속이 불가능할 수 있습니다.
                    </p>
                    <p class="text-sm font-bold text-amber-300 mt-2" data-lang-key="googleFormAlternative">
                        **접속이 어려운 경우, 아래 이메일 주소로 별도 신청**을 부탁드립니다.
                    </p>
                    <a href="mailto:agt2027.incheon@email.com" class="underline text-amber-300 hover:text-amber-200">agt2027.incheon@email.com</a>
                </div>
                <!-- 공통 안내 -->
                <!-- <div class="text-center">
                    <p class="text-slate-200" data-lang-key="registrationCommonNotice">
                        Alle Anmeldeformulare (Sektion, Vortrag, Teilnahme) enthalten auch die Anmeldung für das Rahmenprogramm.
                    </p>
                    <p class="text-amber-300 mt-2" data-lang-key="registerNote">
                        * Sektionsleiter und Vortragende müssen sich ebenfalls als Teilnehmende registrieren.
                    </p>
                </div> -->

                <div class="border-t border-slate-700 pt-6 mt-6">
                    <h3 class="text-2xl font-bold text-white text-center mb-4" data-lang-key="feeDetailsTitle">Teilnahmegebühren</h3>
                    <ul class="flex flex-col md:flex-row justify-center items-center gap-4 md:gap-8 text-lg text-center mb-6">
                        <li class="flex items-center gap-2" data-lang-key="feeFullTime"><span class="w-3 h-3 inline-block bg-amber-400 rounded-full"></span>Vollzeit/Teilzeit: 150.000 KRW</li>
                        <li class="flex items-center gap-2" data-lang-key="feeStudent"><span class="w-3 h-3 inline-block bg-amber-400 rounded-full"></span>Studierende: 50.000 KRW</li>
                        <!-- <li class="flex items-center gap-2" data-lang-key="feeSocialProgram"><span class="w-3 h-3 inline-block bg-amber-400 rounded-full"></span>Rahmenprogramm: 50.000 KRW</li> -->
                    </ul>
                    <div class="text-center p-4 bg-slate-800 rounded-lg mb-4">
                        <h4 class="text-xl font-bold text-amber-400 mb-2" data-lang-key="bankTransferTitle">Überweisung / Bank Transfer</h4>
                        <p class="text-base text-white font-mono" data-lang-key="bankDetails">
                            Kookmin Bank (KB): 098001-00-005911
                        </p>
                        <p class="text-sm text-slate-400" data-lang-key="bankAccountHolder">
                            (Koreanische Gesellschaft fuer Germanistik)
                        </p>
                        <ul class="text-sm text-slate-400 mt-4" data-lang-key-list="internationalBankInfo">
                        </ul>
                   </div>
                    <div class="text-center border-t border-slate-800 pt-4 mt-4">
                         <p class="font-semibold text-amber-300" data-lang-key="paymentCompletionNotice">
                            Die Anmeldung ist erst nach Eingang der Teilnahmegebühr (ggf. inkl. der Gebühr für das Rahmenprogramm) abgeschlossen.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </main>
    <Footer />
</Layout>

