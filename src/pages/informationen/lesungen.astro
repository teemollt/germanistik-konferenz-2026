---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { content } from '../../i18n/content';
---

<Layout title="Lesungen - AGT 2026 Incheon">
    <Header />
    <main class="relative z-30 py-20 md:py-24 bg-[#14223f]">
        <div class="container mx-auto px-6">
            <h2 class="text-4xl md:text-5xl font-extrabold text-center mb-12 md:mb-16" data-lang-key="subInfoLesungen">Lesungen</h2>
            <div class="max-w-4xl mx-auto text-slate-300">
                <p class="mb-4">
                    Im Rahmen der Konferenz werden Autorenlesungen stattfinden. Details zu den Autoren und die genauen Termine werden hier bekannt gegeben.
                </p>
                <p>
                    Freuen Sie sich auf spannende Einblicke in die zeitgenössische deutschsprachige Literatur.
                </p>
            </div>
        </div>
    </main>
    <Footer />
</Layout>