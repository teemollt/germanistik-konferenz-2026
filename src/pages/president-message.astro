<Layout title="Grußwort - AGT 2027 Incheon">
    <Header />
    <main class="relative z-30 py-20 md:py-24 bg-gray-800">
        <section id="president-message" class="container mx-auto px-6">
            <h2 class="text-4xl md:text-5xl font-extrabold text-center mb-12 md:mb-16" data-lang-key="presidentMessageTitle"></h2>
            
            <!-- ▼▼▼ 수정된 부분 ▼▼▼ -->
            <div class="max-w-4xl mx-auto bg-slate-800/50 p-8 md:p-10 rounded-lg shadow-xl">
                <div class="text-slate-300 text-lg leading-relaxed space-y-6">
                    <p data-lang-key="presidentDesc1"></p>
                    <p data-lang-key="presidentDesc2"></p>
                    <p data-lang-key="presidentDesc3"></p>
                    
                    <!-- 서명 부분을 시각적으로 구분 -->
                    <div class="border-t border-slate-700 pt-6 mt-8">
                        <p class="font-bold text-white" data-lang-key="presidentName"></p>
                        <p class="text-base text-slate-400" data-lang-key="presidentTitleOrg"></p>
                    </div>
                </div>
            </div>
            
        </section>
    </main>
    <Footer />
</Layout>

