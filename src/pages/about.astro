---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Über die AGT - AGT 2027 Incheon">
    <Header />
    <main class="relative z-30 py-20 md:py-24">
        <section id="about" class="container mx-auto px-6">
            <h2 class="text-4xl md:text-5xl font-extrabold text-center mb-12 md:mb-16" data-lang-key="aboutTitle">Über AGT</h2>
            <div class="max-w-4xl mx-auto text-slate-300 text-lg leading-relaxed space-y-6">
                <p data-lang-key="aboutP1"></p>
                <p data-lang-key="aboutP2"></p>

                <ul class="list-disc list-inside space-y-2 pl-4" data-lang-key-list="aboutConferenceList">
                </ul>

                <p data-lang-key="aboutP3"></p>
                <p data-lang-key="aboutP4"></p>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
